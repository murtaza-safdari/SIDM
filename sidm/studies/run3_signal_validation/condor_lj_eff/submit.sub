# submit from a work directory:  condor_submit CODEDIR=<this dir> ARGS=<job_args file> submit.sub
# (make_tarball.sh <work dir> first; logs/ and the output jsons land in the work directory)
universe = vanilla
executable = $(CODEDIR)/run_lj_eff.sh
arguments = $(mode) $(era) $(names) 12 25 lj_$(mode)_$(era)_$(part).json
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = lj_eff_code.tar.gz, $(CODEDIR)/../../../../condor/requirements.txt
transfer_output_files = lj_$(mode)_$(era)_$(part).json
output = logs/$(mode)_$(era)_$(part)_$(Cluster).out
error  = logs/$(mode)_$(era)_$(part)_$(Cluster).err
log    = logs/lj_eff_$(Cluster).log
request_cpus = 1
request_memory = 4GB
request_disk = 6GB
x509userproxy = $ENV(X509_USER_PROXY)
queue mode, era, part, names from $(ARGS)
