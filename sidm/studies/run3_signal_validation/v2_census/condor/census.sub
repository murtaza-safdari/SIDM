# Submit from a run directory holding setup_env.sh, run_census.sh, census_files.py, ../era_fingerprint.py and condor/requirements.txt (the last from the repository root),
# with the job lists in ../joblists/ (expected.py) and empty out/ and logs/ directories; see ../README.md.
universe = vanilla
executable = run_census.sh
arguments = $(job)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = setup_env.sh, census_files.py, era_fingerprint.py, requirements.txt, ../joblists/job_$(job).txt
transfer_output_files = census_$(job).csv, branches_$(job).json
transfer_output_remaps = "census_$(job).csv = out/census_$(job).csv; branches_$(job).json = out/branches_$(job).json"
output = logs/census_$(job).$(Cluster).out
error  = logs/census_$(job).$(Cluster).err
log    = logs/census.$(Cluster).log
request_cpus = 1
request_memory = 2GB
request_disk = 2GB
x509userproxy = $ENV(X509_USER_PROXY)
queue job from jobs.txt
